@{
    ViewData["Title"] = "NSE 500 Charts";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NSE 500 Charts — Monthly · Weekly · Daily · 1H</title>

<script>
  // Applied before CSS/paint so a saved theme/density never flashes the
  // wrong value. Defaults (light theme, compact density) need no attribute
  // since the stylesheet's :root already defines them.
  (function () {
    try {
      var raw = localStorage.getItem('nseCharts.settings');
      var s = raw ? JSON.parse(raw) : null;
      var theme = (s && s.theme) || 'light';
      var density = (s && s.density) || 'compact';
      if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      if (density === 'spacious') document.documentElement.setAttribute('data-density', 'spacious');
    } catch (e) { /* localStorage unavailable — fall back to defaults */ }
  })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/style.css" asp-append-version="true">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
</head>
<body>

<div class="app" id="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div>
        <div class="brand-mark">
          <span class="dot"></span>
          <h1>NSE 500 CHARTS</h1>
        </div>
        <div class="brand-sub">M · W · D · 1H quad view</div>
      </div>
      <button class="icon-btn" id="settingsBtn" title="Settings">⚙</button>
    </div>

    <div class="search-wrap">
      <input type="text" id="searchInput" class="search-input" placeholder="Search symbol, company, or type any ticker…" autocomplete="off">
    </div>

    <div class="pinned-row" id="pinnedNifty" title="Nifty 50 index">
      <span class="sym">NIFTY 50</span>
      <span class="sector">Index</span>
    </div>

    <div class="list-meta">
      <select id="sortSelect" class="sort-select" title="Sort symbols by">
        <option value="change">Sort: Change %</option>
        <option value="momentum">Sort: Momentum</option>
        <option value="symbol">Sort: Symbol</option>
        <option value="sector">Sort: Sector</option>
      </select>
      <select id="filterSelect" class="sort-select" title="Filter symbols by">
        <option value="all">Filter: All</option>
        <option value="positive">Filter: +Change %</option>
        <option value="negative">Filter: -Change %</option>
        <option value="nearHigh">Filter: Near 52W High</option>
        <option value="above5sma">Filter: Above 5 SMA (Daily)</option>
      </select>
      <select id="signalSelect" class="sort-select" title="Filter symbols by signal">
        <option value="all">Signal: All</option>
        <option value="signalBuy">Signal: BUY / HOLD</option>
        <option value="signalWatch">Signal: WATCH</option>
        <option value="signalAvoid">Signal: AVOID</option>
      </select>
      <span id="listMeta">Loading…</span>
    </div>

    <div class="sync-bar">
      <button id="syncNowBtn" class="sync-btn" type="button" title="Refresh every symbol">Sync now</button>
      <button id="syncPendingBtn" class="sync-btn secondary" type="button" title="Refresh symbols not synced today">Sync pending</button>
      <button id="stopSyncBtn" class="sync-btn stop" type="button" title="Stop syncing" aria-label="Stop syncing">■</button>
      <span id="syncSummary" class="sync-summary"></span>
    </div>

    <div class="stock-list" id="stockList">
      <div class="empty-hint">Loading NSE 500 list…</div>
    </div>

    <div class="disclosure">
      Data via Yahoo Finance (unofficial, free). For reference only — not investment advice.
    </div>
  </aside>

  <div class="scrim" id="scrim"></div>

  <main class="main">
    <div class="topbar">
      <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div id="topbarInfo" style="display:none; align-items:center; gap:14px;">
          <div class="sym-block">
            <div class="big-sym">
              <span class="symtext">—</span>
              <span class="exchange-tag">NSE</span>
            </div>
            <div class="company-name">Select a symbol from the list</div>
          </div>
        </div>
      </div>

      <div class="topbar-right">
        <div class="price-block" id="priceBlock"></div>
        <button class="nav-btn" id="prevBtn" disabled title="Previous symbol (↑)">◀</button>
        <button class="nav-btn" id="nextBtn" disabled title="Next symbol (↓ or Shift+scroll)">▶</button>
        <button class="analysis-btn" id="analysisBtn" aria-label="Show analysis table" aria-pressed="false" title="Show analysis table">▥</button>
        <button class="refresh-btn" id="refreshBtn" title="Reload charts">⟳</button>
      </div>
    </div>

    <div class="grid-wrap" id="gridWrap">
      <div class="placeholder" id="placeholder">
        <span class="big-dot"></span>
        <h2>Pick a stock to load its charts</h2>
        <p>
          Click any symbol on the left, or use <b>↑ / ↓</b> once you've picked one to jump
          through the list. Holding <b>Shift</b> while scrolling over this area also moves
          to the next / previous symbol. Every stock loads four synced views —
          Monthly, Weekly, Daily and 1‑Hour.
        </p>
      </div>

      <div class="chart-grid" id="chartGrid"></div>

      <section class="analysis-view" id="analysisView" aria-live="polite">
        <div class="analysis-head">
          <div>
            <div class="analysis-kicker">STOCK PREDICTION DESK</div>
            <h2 id="analysisTitle">Select a stock</h2>
          </div>
          <div class="analysis-actions">
            <div class="column-info-wrap">
              <button class="column-info-btn" id="columnInfoBtn" aria-label="Show table column details" title="Table column details">?</button>
              <div class="column-info-popover" id="columnInfoPopover" role="tooltip">
                <strong>How to read this table</strong>
                <span class="column-info-intro">This is a research and comparison view, not a promise of profit. Look for a stronger signal, a healthy winning rate, realistic upside, and controlled downside together.</span>
                <span><b>Signal</b> The model's overall suggestion. <em>BUY / HOLD</em> means the setup is strongest, <em>WATCH</em> means conditions are mixed, and <em>AVOID</em> means the setup is currently weak.</span>
                <span><b>Winning rate</b> How often similar past setups reached their target before the stop. A higher percentage is generally better, but it is an estimate, not a guarantee.</span>
                <span><b>Target %</b> The possible gain from the entry price if the target is reached. Higher may look attractive, but ambitious targets are harder to reach.</span>
                <span><b>Loss %</b> The planned drop from entry to the stop-loss level. A smaller absolute percentage usually means more controlled risk.</span>
                <span><b>Risk : Reward</b> How much gain is targeted for every 1 unit of risk taken from entry to stop. The model currently targets 2 units of reward per 1 unit of risk.</span>
                <span><b>Trend score</b> How many technical conditions agree with an upward trend. <em>4–5</em> is strong, <em>2–3</em> is mixed, and <em>0–1</em> is weak.</span>
                <span><b>Momentum</b> The recent direction of price movement. Positive values show upward movement, negative values show downward movement, and values near zero show little movement.</span>
                <span><b>SMA alignment</b> Compares today’s price with its 5, 20, 50, and 200-day averages. ▲ means price is above an average, ▼ means below it, and • means there is not enough data. More ▲ symbols usually indicate stronger alignment.</span>
              </div>
            </div>
          </div>
        </div>
        <div id="predictionPanel" class="prediction-panel">
          <div class="analysis-empty">Select a stock to calculate its long-only setup.</div>
        </div>
      </section>
    </div>
  </main>
</div>

<!-- Settings Modal (simplified version) -->
<div class="modal-scrim" id="settingsScrim">
  <div class="settings-modal">
    <div class="settings-head">
      <h3>Settings</h3>
      <button class="settings-close" id="settingsClose">✕</button>
    </div>
    <div class="settings-body">
      <div class="settings-section">
        <h4>Appearance</h4>
        <div class="settings-row">
          <span class="row-label">Theme</span>
          <div class="segmented" id="themeSeg">
            <button data-val="light">Light</button>
            <button data-val="dark">Dark</button>
          </div>
        </div>
        <div class="settings-row">
          <span class="row-label">Layout density</span>
          <div class="segmented" id="densitySeg">
            <button data-val="compact">Compact</button>
            <button data-val="spacious">Spacious</button>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <h4>Data Source</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Provider</div>
            <div class="row-hint">Yahoo Finance via server-side proxy</div>
          </div>
          <div class="segmented" id="sourceSeg">
            <button data-val="yahoo" class="active">Yahoo Finance</button>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <h4>Chart data</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Bars per chart</div>
            <div class="row-hint">Most recent candles shown</div>
          </div>
          <input type="number" id="barCountInput" class="settings-input" min="20" max="2000" step="10" value="80">
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Price axis decimals</div>
            <div class="row-hint">Right-side price precision</div>
          </div>
          <select id="decimalsSelect" class="settings-select">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>
      </div>

      <div class="settings-section">
        <h4>Indicators</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">SMA (5)</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="smaToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">RSI (14)</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="rsiToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">MACD</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="macdToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Candlestick patterns</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="patternsToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
      </div>

      <div class="settings-section">
        <h4>Behavior</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Load Nifty 50 on start</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="niftyToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
      </div>

      <div class="settings-section">
        <h4>Visible Charts</h4>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="M" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">Monthly</span>
        </div>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="W" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">Weekly</span>
        </div>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="D" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">Daily</span>
        </div>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="H" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">1 Hour</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- jQuery (CDN) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

<!-- Lightweight Charts by TradingView -->
<script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>

<!-- NSE 500 symbol list -->
<script src="~/stocks.js" asp-append-version="true"></script>

<!-- Data source registry -->
<script src="~/datasources.js" asp-append-version="true"></script>

<!-- Long-only stock prediction and fundamental analysis -->
<script src="~/prediction.js" asp-append-version="true"></script>

<!-- Candlestick pattern detection + chart labels -->
<script src="~/patterns.js" asp-append-version="true"></script>

<!-- App logic -->
<script src="~/app.js" asp-append-version="true"></script>

</body>
</html>
