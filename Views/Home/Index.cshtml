@{
    ViewData["Title"] = "NSE 500 Charts";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NSE 500 Charts — Monthly · Weekly · Daily · 1H</title>

<script>
  // Applied before CSS/paint so a saved theme/density never flashes the
  // wrong value. Defaults (light theme, compact density) need no attribute
  // since the stylesheet's :root already defines them.
  (function () {
    try {
      var raw = localStorage.getItem('nseCharts.settings');
      var s = raw ? JSON.parse(raw) : null;
      var theme = (s && s.theme) || 'light';
      var density = (s && s.density) || 'compact';
      if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      if (density === 'spacious') document.documentElement.setAttribute('data-density', 'spacious');
    } catch (e) { /* localStorage unavailable — fall back to defaults */ }
  })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/style.css" asp-append-version="true">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
</head>
<body>

<div class="app" id="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div>
        <div class="brand-mark">
          <span class="dot"></span>
          <h1>NSE INDEX CHARTS</h1>
        </div>
        @* <div class="brand-sub">M · W · D · 1H quad view</div> *@
      </div>
      <button class="icon-btn" id="settingsBtn" title="Settings">⚙</button>
    </div>

    <label class="universe-select-wrap">
      <span>Market index</span>
      <select id="indexSelect" class="universe-select" aria-label="Select market index">
        <optgroup label="Broad market">
          <option value="nifty50">NIFTY 50</option>
          <option value="niftynext50">NIFTY Next 50</option>
          <option value="nifty100">NIFTY 100</option>
          <option value="nifty200">NIFTY 200</option>
          <option value="nifty500" selected>NIFTY 500</option>
          <option value="niftyipo">NIFTY IPO</option>
        </optgroup>
        <optgroup label="Market capitalization">
          <option value="niftymidcap50">NIFTY Midcap 50</option>
          <option value="niftymidcap100">NIFTY Midcap 100</option>
          <option value="niftymidcap150">NIFTY Midcap 150</option>
          <option value="niftysmallcap50">NIFTY Smallcap 50</option>
          <option value="niftysmallcap100">NIFTY Smallcap 100</option>
          <option value="niftysmallcap250">NIFTY Smallcap 250</option>
        </optgroup>
        <optgroup label="Sector indexes">
          <option value="niftybank">NIFTY Bank</option>
          <option value="niftyfinancialservices">NIFTY Financial Services</option>
          <option value="niftyit">NIFTY IT</option>
          <option value="niftyauto">NIFTY Auto</option>
          <option value="niftyfmcg">NIFTY FMCG</option>
          <option value="niftypharma">NIFTY Pharma</option>
          <option value="niftymetal">NIFTY Metal</option>
          <option value="niftymedia">NIFTY Media</option>
          <option value="niftyrealty">NIFTY Realty</option>
          <option value="niftyenergy">NIFTY Energy</option>
          <option value="niftypsubank">NIFTY PSU Bank</option>
        </optgroup>
      </select>
    </label>
    <div id="indexLoadStatus" class="index-load-status" aria-live="polite"></div>

    <div class="search-wrap">
      <input type="text" id="searchInput" class="search-input" placeholder="Search symbol, company, or type any ticker…" autocomplete="off">
      <button type="button" id="addSymbolBtn" class="add-symbol-btn" title="Add typed symbol and load its charts + analysis">+ Add symbol</button>
    </div>

    <div class="pinned-row" id="pinnedNifty" title="Nifty 50 index">
      <span class="sym">NIFTY 50</span>
      <span class="sector">Index</span>
    </div>

    <div class="list-meta">
      <select id="sortSelect" class="sort-select" title="Sort symbols by">
        <option value="change">Sort: Change %</option>
        <option value="momentum">Sort: Momentum</option>
        <option value="symbol">Sort: Symbol</option>
        <option value="sector">Sort: Sector</option>
      </select>
      <button type="button" id="filterBtn" class="filter-btn" title="Configure stock filters" aria-label="Configure stock filters" aria-haspopup="dialog">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14l-5.5 6.2v4.2l-3 1.6v-5.8L3 4z" /></svg>
        <span>Filters</span>
        <span id="filterCount" class="filter-count" aria-label="Active filter count">0</span>
      </button>
      <span id="listMeta">Loading…</span>
    </div>
    <div id="activeFilterSummary" class="active-filter-summary">No filters selected</div>

    <div class="sync-bar">
      <button id="syncNowBtn" class="sync-btn" type="button" title="Refresh every symbol">Sync now</button>
      <button id="syncPendingBtn" class="sync-btn secondary" type="button" title="Refresh symbols not synced today">Sync pending</button>
      <button id="stopSyncBtn" class="sync-btn stop" type="button" title="Stop syncing" aria-label="Stop syncing">■</button>
      <span id="syncSummary" class="sync-summary"></span>
    </div>

    <div class="stock-list" id="stockList">
      <div class="empty-hint">Loading index constituents…</div>
    </div>

    <div class="disclosure">
      Data via Yahoo Finance (unofficial, free). For reference only — not investment advice.
    </div>
  </aside>

  <div class="scrim" id="scrim"></div>

  <main class="main">
    <div class="topbar">
      <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div id="topbarInfo" style="display:none; align-items:center; gap:14px;">
          <div class="sym-block">
            <div class="big-sym">
              <span class="symtext">—</span>
              @*<span class="exchange-tag">NSE</span> *@
            </div>
            <div class="sector-name">—</div>
            <div class="company-name">Select a symbol from the list</div>
          </div>
        </div>
      </div>

      <div class="topbar-right">
        <div class="price-block" id="priceBlock"></div>
        <button class="nav-btn" id="prevBtn" disabled title="Previous symbol (↑)">◀</button>
        <button class="nav-btn" id="nextBtn" disabled title="Next symbol (↓ or Shift+scroll)">▶</button>
        <button class="analysis-btn" id="analysisBtn" aria-label="Show analysis table" aria-pressed="false" title="Show analysis table">▥</button>
        <button class="refresh-btn" id="refreshBtn" title="Reload charts">⟳</button>
        <button class="fullscreen-btn" id="fullscreenBtn" type="button" aria-label="Enter fullscreen" aria-pressed="false" title="Enter fullscreen">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path class="enter-icon" d="M7 3H3v4m10-4h4v4M17 13v4h-4m-6 0H3v-4"/><path class="exit-icon" d="M7 3v4H3m10-4v4h4m0 6h-4v4m-6 0v-4H3"/></svg>
        </button>
      </div>
    </div>

    <div class="grid-wrap" id="gridWrap">
      <div class="stock-chart-view" id="stockChartView">
      <div class="placeholder" id="placeholder">
        <span class="big-dot"></span>
        <h2>Pick a stock to load its charts</h2>
        <p>
          Click any symbol on the left, or use <b>↑ / ↓</b> once you've picked one to jump
          through the list. Holding <b>Shift</b> while scrolling over this area also moves
          to the next / previous symbol. Every stock loads four synced views —
          Monthly, Weekly, Daily and 1‑Hour.
        </p>
      </div>

      <div class="chart-grid" id="chartGrid"></div>
      </div>

      <section class="analysis-view" id="analysisView" aria-live="polite">
        <div class="analysis-head">
          <div>
            <div class="analysis-kicker">STOCK PREDICTION DESK</div>
            <h2 id="analysisTitle">Select a stock</h2>
          </div>
          <div class="analysis-actions">
            <div class="column-info-wrap">
              <button class="column-info-btn" id="columnInfoBtn" aria-label="Show table column details" title="Table column details">?</button>
              <div class="column-info-popover" id="columnInfoPopover" role="tooltip">
                  <strong>How to read this table</strong>
                  <span class="column-info-intro">This is a research and comparison view, not a promise of profit. Look for a stronger signal, a healthy winning rate, realistic upside, and controlled downside together.</span>
                  <span><b>Signal</b> The model's overall suggestion. <em>BUY / HOLD</em> means the setup is strongest, <em>WATCH</em> means conditions are mixed, and <em>AVOID</em> means the setup is currently weak.</span>
                  <span><b>Winning rate (D | W | M)</b> D, W, and M mean daily, weekly, and monthly candles. The model tests up to 100 past entry candles and checks the next 3–10 candles. A win means the target was reached before the stop. The percentage is wins ÷ all tested setups × 100, rounded to a whole number. Stop-first and no-hit cases are not wins; if both levels are touched in one candle, the stop is counted first. “—” means there are too few samples. This is a historical estimate, not a promise.</span>
                  <span><b>Target %</b> The possible gain from the entry price if the target is reached. Higher may look attractive, but ambitious targets are harder to reach.</span>
                  <span><b>Loss %</b> The planned drop from entry to the stop-loss level. A smaller absolute percentage usually means more controlled risk.</span>
                <span><b>Risk : Reward</b> How much gain is targeted for every 1 unit of risk taken from entry to stop. The model currently targets 2 units of reward per 1 unit of risk.</span>
                  <span><b>Trend score</b> How many technical conditions agree with an upward trend. <em>4–5</em> is strong, <em>2–3</em> is mixed, and <em>0–1</em> is weak.</span>
                  <span><b>Momentum</b> The recent direction of price movement. Positive values show upward movement, negative values show downward movement, and values near zero show little movement.</span>
                <span><b>SMA alignment</b> Compares today’s price with its 5, 20, 50, and 200-day averages. ▲ means price is above an average, ▼ means below it, and • means there is not enough data. More ▲ symbols usually indicate stronger alignment.</span>
            </div>
            </div>
          </div>         
        </div>   
         <div id="predictionPanel" class="prediction-panel">
            <div class="analysis-empty">Select a stock to calculate its long-only setup.</div>
          </div>     
      </section>
    </div>
  </main>
</div>

<div class="modal-scrim" id="filterScrim">
  <section class="settings-modal filter-modal" id="filterModal" role="dialog" aria-modal="true" aria-labelledby="filterTitle">
    <div class="settings-head">
      <h3 id="filterTitle">Stock filters</h3>
      <button type="button" class="settings-close" id="filterClose" aria-label="Close filters">✕</button>
    </div>
    <div class="settings-body">
      <div class="settings-section">
        <h4>Signal</h4>
        <div class="signal-filter-options">
          <label class="filter-check-row"><input type="checkbox" id="signalAll"><span>All signals</span></label>
          <label class="filter-check-row"><input type="checkbox" class="signal-option" value="signalBuy"><span>BUY / HOLD</span></label>
          <label class="filter-check-row"><input type="checkbox" class="signal-option" value="signalWatch"><span>WATCH</span></label>
          <label class="filter-check-row"><input type="checkbox" class="signal-option" value="signalAvoid"><span>AVOID</span></label>
        </div>
      </div>
      <div class="settings-section">
        <h4>Daily Change %</h4>
        <label class="filter-enable-row"><input type="checkbox" id="changeFilterEnabled"><span>Filter by daily change</span></label>
        <div class="filter-control-row" id="changeFilterControls">
          <select id="changeFilterOperator" class="settings-select" aria-label="Change percentage comparison">
            <option value="gt">Greater than</option>
            <option value="lt">Less than</option>
          </select>
          <label class="filter-value"><input type="number" id="changeFilterValue" class="settings-input" step="0.1"> <span>%</span></label>
        </div>
      </div>
      <div class="settings-section">
        <h4>Price High</h4>
        <label class="filter-enable-row"><input type="checkbox" id="highFilterEnabled"><span>Filter by distance from a high</span></label>
        <div class="filter-control-row" id="highFilterControls">
          <select id="highFilterSource" class="settings-select" aria-label="Price high reference">
            <option value="allTimeHigh">All-time high</option>
            <option value="fiftyTwoWeekHigh">52-week high</option>
          </select>
          <label class="filter-value"><span>Within</span> <input type="number" id="highFilterPercent" class="settings-input" min="0" max="100" step="0.1"> <span>%</span></label>
        </div>
      </div>
      <div class="settings-section">
        <h4>Recent high touch</h4>
        <div class="recent-high-filter-row" id="recentHighFilterControls">
          <label class="filter-enable-row"><input type="checkbox" id="recentHighFilterEnabled" aria-label="Enable recent high touch filter"></label>
          <select id="recentHighFilterSource" class="settings-select" aria-label="Recent high type">
            <option value="allTimeHigh">All-time high</option>
            <option value="fiftyTwoWeekHigh">52-week high</option>
          </select>
          <label class="filter-value"><span>Last</span> <input type="number" id="recentHighFilterMonths" class="settings-input" min="1" max="60" step="1" aria-label="Number of months"> <span>mo</span></label>
        </div>
        <div class="recent-high-hint">Daily high within 0.1%</div>
      </div>
      <div class="settings-section">
        <div class="filter-section-heading">
          <h4>Trend-line breakout</h4>
          <div class="filter-info-wrap">
            <button type="button" class="column-info-btn filter-info-btn" id="trendlineInfoBtn" aria-label="Trend-line breakout details" aria-expanded="false" title="Trend-line breakout details">i</button>
            <div class="column-info-popover trendline-info-popover" id="trendlineInfoPopover" role="tooltip">
              <strong>Trend-line breakout</strong>
              <span>Daily close crosses descending resistance from confirmed swing highs. Probability is the historical rate of a higher next-day close after matching breakouts; at least 5 past examples are required.</span>
            </div>
          </div>
        </div>
        <label class="filter-enable-row"><input type="checkbox" id="breakoutFilterEnabled"><span>Filter for bullish trend-line breakouts</span></label>
        <div class="filter-control-row" id="breakoutProbabilityControls">
          <label class="filter-value"><span>Minimum probability</span> <input type="number" id="breakoutProbability" class="settings-input" min="0" max="100" step="5"> <span>%</span></label>
        </div>
      </div>
      <div class="settings-section">
        <h4>Above 5 SMA</h4>
        <div class="sma-filter-options">
          <label class="filter-check-row"><input type="checkbox" id="smaDailyFilter"><span>Daily</span></label>
          <label class="filter-check-row"><input type="checkbox" id="smaWeeklyFilter"><span>Weekly</span></label>
          <label class="filter-check-row"><input type="checkbox" id="smaMonthlyFilter"><span>Monthly</span></label>
        </div>
      </div>
      <div class="filter-actions">
        <button type="button" class="filter-clear-btn" id="clearFiltersBtn">Clear filters</button>
        <button type="button" class="sync-btn" id="filterDoneBtn">Done</button>
      </div>
    </div>
  </section>
</div>

<!-- Settings Modal (simplified version) -->
<div class="modal-scrim" id="settingsScrim">
  <div class="settings-modal">
    <div class="settings-head">
      <h3>Settings</h3>
      <button class="settings-close" id="settingsClose">✕</button>
    </div>
    <div class="settings-body">
      <div class="settings-section">
        <h4>Chart layout</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Grid columns</div>
            <div class="row-hint">Responsive or fixed number of columns</div>
          </div>
          <select id="chartColumnsSelect" class="settings-select" title="Chart grid columns">
            <option value="0">Responsive</option>
            <option value="1">1 column</option>
            <option value="2">2 columns</option>
            <option value="3">3 columns</option>
            <option value="4">4 columns</option>
          </select>
        </div>
      </div>
      <div class="settings-section">
        <h4>Appearance</h4>
        <div class="settings-row">
          <span class="row-label">Theme</span>
          <div class="segmented" id="themeSeg">
            <button data-val="light">Light</button>
            <button data-val="dark">Dark</button>
          </div>
        </div>
        <div class="settings-row">
          <span class="row-label">Layout density</span>
          <div class="segmented" id="densitySeg">
            <button data-val="compact">Compact</button>
            <button data-val="spacious">Spacious</button>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <h4>Data Source</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Provider</div>
            <div class="row-hint">Yahoo Finance via server-side proxy</div>
          </div>
          <div class="segmented" id="sourceSeg">
            <button data-val="yahoo" class="active">Yahoo Finance</button>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <h4>Chart data</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Bars per chart</div>
            <div class="row-hint">Most recent candles shown</div>
          </div>
          <input type="number" id="barCountInput" class="settings-input" min="20" max="2000" step="10" value="80">
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Analysis data points</div>
            <div class="row-hint">Candles used for win-rate analysis (loaded, not all shown)</div>
          </div>
          <input type="number" id="analysisPointsInput" class="settings-input" min="20" max="2000" step="10" value="150">
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Right axis</div>
            <div class="row-hint">Scale shows % change by default</div>
          </div>
          <div class="segmented" id="axisModeSeg">
            <button data-val="percent" class="active">% Change</button>
            <button data-val="price">Price</button>
          </div>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Price axis decimals</div>
            <div class="row-hint">Right-side price precision</div>
          </div>
          <select id="decimalsSelect" class="settings-select">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Percent base</div>
            <div class="row-hint">0% reference on the % axis</div>
          </div>
          <select id="percentBaseSelect" class="settings-select">
            <option value="current">Current price = 0%</option>
            <option value="first">First visible bar = 0%</option>
          </select>
        </div>
      </div>

      <div class="settings-section">
        <h4>Indicators</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">SMA (5)</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="smaToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Volume profile</div>
            <div class="row-hint">Volume by price on the left side of each chart</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="volumeProfileToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Profile rows</div>
            <div class="row-hint">Price levels used to group volume</div>
          </div>
          <input type="number" id="volumeProfileBinsInput" class="settings-input" min="8" max="64" step="1" value="24">
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Supertrend</div>
            <div class="row-hint">Trailing trend line (ATR period below)</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="supertrendToggle">
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Supertrend period</div>
            <div class="row-hint">ATR lookback (default 5)</div>
          </div>
          <input type="number" id="supertrendPeriodInput" class="settings-input" min="1" max="50" step="1" value="5">
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">RSI (14)</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="rsiToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">MACD</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="macdToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">MFI (14)</div>
            <div class="row-hint">Money Flow Index - volume-weighted RSI</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="mfiToggle">
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Candlestick patterns</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="patternsToggle">
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Win rate / target / stop values in header</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="winRateHeaderValuesToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
        <div class="settings-row">
          <div>
            <div class="row-label">Target / stop lines inside chart</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="winRateChartLinesToggle">
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
      </div>

      <div class="settings-section">
        <h4>Behavior</h4>
        <div class="settings-row">
          <div>
            <div class="row-label">Load Nifty 50 on start</div>
          </div>
          <label class="toggle-switch">
            <input type="checkbox" id="niftyToggle" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
        </div>
      </div>

      <div class="settings-section">
        <h4>Visible Charts</h4>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="M" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">Monthly</span>
        </div>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="W" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">Weekly</span>
        </div>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="D" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">Daily</span>
        </div>
        <div class="settings-row">
          <label class="toggle-switch">
            <input type="checkbox" class="panel-toggle" data-tf="H" checked>
            <span class="track"></span>
            <span class="thumb"></span>
          </label>
          <span class="row-label" style="flex:1;">1 Hour</span>
        </div>
      </div>
    </div>
  </div>
